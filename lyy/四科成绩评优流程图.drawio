        </mxCell>

        <!-- 输入四科成绩 -->
        <mxCell id="input" value="输入四科成绩（字符串）&#10;language, math, english, science&#10;= input().split(' ')" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">

<mxfile host="app.diagrams.net" type="device">
  <diagram id="electricity" name="居民阶梯电价流程图">
    <mxGraphModel dx="1100" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1169" math="0" shadow="0">
      <root>

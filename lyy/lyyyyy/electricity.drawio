        <mxCell id="3" value="输入居民月用电量 x (度)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="320" height="50" as="geometry" />
